# Scheduler Service Dockerfile for Render
FROM python:3.11-slim

# Set working directory  
WORKDIR /app

# Install system dependencies for PostgreSQL and other requirements
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy worker requirements and install Python dependencies
COPY apps/worker/requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt

# Copy worker application code
COPY apps/worker/ .

# Create non-root user for security
RUN groupadd -r hawanama && useradd -r -g hawanama hawanama
RUN chown -R hawanama:hawanama /app
USER hawanama

# Health check for scheduler
HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
  CMD celery -A config.celery_app inspect scheduled || exit 1

# Command for scheduler (Celery Beat)
CMD ["celery", "-A", "config.celery_app", "beat", "--loglevel=info"]