{
  "hosting": [
    {
      "site": "hawanama-dashboard",
      "public": "apps/web-next/out",
      "trailingSlash": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "hawanama", "region": "asia-south1" }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://api.mapbox.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://hawanama-152782825429.asia-south1.run.app https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://tile.openstreetmap.org; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.@(v1.png|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/@(sitemap.xml|robots.txt)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        }
      ]
    },
    {
      "site": "hawanama-2",
      "public": "apps/dashboard-frontend/out",
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/emissions{,/**}",
          "destination": "https://emissions.hawanama.org",
          "type": 302
        },
        { "source": "/city", "destination": "https://hawanama-dashboard.web.app/city/", "type": 301 },
        { "source": "/city/:path*", "destination": "https://hawanama-dashboard.web.app/city/:path*/", "type": 301 },
        { "source": "/station/:path*", "destination": "https://hawanama-dashboard.web.app/station/:path*/", "type": 301 },
        { "source": "/about", "destination": "https://hawanama-dashboard.web.app/about/", "type": 301 },
        { "source": "/about/:path*", "destination": "https://hawanama-dashboard.web.app/about/:path*/", "type": 301 },
        { "source": "/sitemap.xml", "destination": "https://hawanama-dashboard.web.app/sitemap.xml", "type": 301 },
        { "source": "/robots.txt", "destination": "https://hawanama-dashboard.web.app/robots.txt", "type": 301 }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "hawanama", "region": "asia-south1" }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    }
  ]
}
