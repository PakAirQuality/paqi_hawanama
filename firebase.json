{
  "hosting": [
    {
      "site": "hawanama-2",
      "public": "apps/web-next/out",
      "trailingSlash": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "hawanama", "region": "asia-south1" }
        }
      ],
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.@(v1.png|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/@(sitemap.xml|robots.txt)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        }
      ]
    },
    {
      "site": "hawanama-dashboard",
      "public": "apps/dashboard-frontend/out",
      "redirects": [
        {
          "source": "/emissions{,/**}",
          "destination": "https://emissions.hawanama.org",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "hawanama", "region": "asia-south1" }
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|png|jpg|svg|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ]
}
