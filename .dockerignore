# send only what the Dockerfile needs
**
!apps/api/**
!apps/worker/**
!apps/api/requirements.txt
!apps/api/start.sh
!apps/api/alembic.ini
!apps/api/Dockerfile
# Never bake credentials into the image, whatever directory they sit in.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json
