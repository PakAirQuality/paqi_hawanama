rules_version = '2';

// The dashboard is a public, read-only static site that talks only to the Hawanama API.
// Nothing in the browser reads or writes Firestore any more, so no client may: every
// collection is server-managed (Admin SDK bypasses these rules). Add a narrowly scoped
// `allow read` under a specific path if a public page ever needs one; never a catch-all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
