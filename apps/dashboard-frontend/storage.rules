rules_version = '2';

// No browser client reads or writes this bucket (the dashboard is public and read-only
// against the Hawanama API). Pipeline artifacts are managed server-side with the Admin
// SDK, which is not subject to these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
