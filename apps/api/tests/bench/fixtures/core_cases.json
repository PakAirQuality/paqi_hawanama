  "cases": [
    {
      "id": "tool-choice-hotspots-001",
      "category": "tool_choice",
      "tier": "deterministic",
      "description": "Basic national hotspots query selects aq_hotspots_daily",
      "session": {"current_date": "2026-03-06"},
      "turns": [
        {
          "user_message": "What are the worst cities today?",
          "expect_tool": "aq_hotspots_daily",
          "expect_args": {"country": "Pakistan"},
          "expect_args_absent": ["sensor_id"],
          "max_tool_calls": 1,
          "expected_focus_type_after_turn": "national",
          "expected_entities_after_turn": ["Lahore", "Faisalabad", "Karachi"],
          "mock_output_key": "hotspots_pakistan_top5",
          "assertions": {
            "text_must_contain": ["Lahore"],
            "text_must_not_contain": ["forecast predicts"],
            "numeric_checks": [
              {"label": "Lahore PM2.5", "expected": 213.5, "tolerance": 1.0}
            ],
            "ranking_check": {
              "expected_order": ["Lahore", "Faisalabad", "Karachi"]
            },
            "provenance_check": {
              "must_say": ["observation"],
              "must_not_say": ["forecast"]
            }
          }
        }
      ]
    },
